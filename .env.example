# Public wallet address to observe. Defaults to the wallet discussed in chat.
SOURCE_WALLET=0xeebde7a0e019a63e6b476eb425505b7b3e6eba30

# Paper simulation only; no live execution credentials are used.
PAPER_START_BALANCE=10000
COPY_MULTIPLIER=1
POLL_INTERVAL_MS=1000

# Set this to /data on Railway and attach a persistent volume at /data.
DATA_DIR=./data

# Railway sets PORT automatically.
PORT=3000
